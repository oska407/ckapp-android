<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 打卡网页容器：原生壳只包这一层，无地址栏 -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 未配对时的扫码/手动配对浮层 -->
    <LinearLayout
        android:id="@+id/pairing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pairTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/pairHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_hint"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <!-- 首次配对时就能选形态：选错端的话界面方向和数据下发都不对，
             不能等到配对完才给改（此处与设置页共用同一套切换逻辑与样式）。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="这台设备用作"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPairFormPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="手机端"
                android:textSize="13sp"
                android:textColor="#B0B0B0"
                android:background="@drawable/bg_form_btn" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPairFormPad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Pad 端"
                android:textSize="13sp"
                android:textColor="#B0B0B0"
                android:background="@drawable/bg_form_btn" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPairFormHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="服务器地址，如 http://192.168.x.x:8787"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="配对 token（32 位 hex）"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etServerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="serverId（16 位 hex）"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair_save" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair_scan"
            android:layout_marginTop="8dp" />

        <!-- 扫码预览（点击“扫描二维码”才显示） -->
        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 设置入口（配对成功后浮动右上角，点开需父母 PIN）。
         用 AppCompatButton 而非 <Button>：Material 主题会把 <Button> 换成 MaterialButton，
         后者默认 48dp 高、主色填充、且不支持 android:background —— 太抢眼。 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="设置"
        android:textSize="11sp"
        android:textColor="#616161"
        android:background="@drawable/bg_settings_btn"
        android:visibility="gone" />

    <!-- 原生设置页（父母 PIN 门禁 + 常驻后台 + 屏幕常亮 + 关于） -->
    <LinearLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#EE111111"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置（家长）"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- 界面形态二选一：默认按屏幕尺寸自动判定，家长可手动锁定（防误判）。
             选中态在代码里换 background：不能用 <Button>，Material 主题会把它换成
             MaterialButton（默认主色紫填充且不支持 android:background），故用 AppCompatButton。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="界面形态"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFormPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="手机端"
                android:textSize="13sp"
                android:textColor="#B0B0B0"
                android:background="@drawable/bg_form_btn" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFormPad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Pad 端"
                android:textSize="13sp"
                android:textColor="#B0B0B0"
                android:background="@drawable/bg_form_btn" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFormHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnPinSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置 / 修改 父母门禁 PIN"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnPinClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清除 父母门禁 PIN"
            android:layout_marginTop="8dp" />

        <Switch
            android:id="@+id/swKeepScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="屏幕常亮（总开关 · 哪些分类常亮在 PC 端系统设置里配）"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

        <Switch
            android:id="@+id/swBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="常驻后台（电池优化豁免）"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="退出应用"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnSettingsClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关闭"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</FrameLayout>
