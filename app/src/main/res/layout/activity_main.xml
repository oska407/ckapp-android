<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 打卡网页容器：原生壳只包这一层，无地址栏 -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 未配对时的扫码/手动配对浮层 -->
    <LinearLayout
        android:id="@+id/pairing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pairTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/pairHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_hint"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="服务器地址，如 http://192.168.x.x:8787"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:hintTextColor="#888888"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="配对 token（32 位 hex）"
            android:textColor="#FFFFFF"
            android:hintTextColor="#888888"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etServerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="serverId（16 位 hex）"
            android:textColor="#FFFFFF"
            android:hintTextColor="#888888"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair_save" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair_scan"
            android:layout_marginTop="8dp" />

        <!-- 扫码预览（点击“扫描二维码”才显示） -->
        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 设置入口（配对成功后浮动在右上角，点开需父母 PIN） -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:visibility="gone" />

    <!-- 原生设置页（父母 PIN 门禁 + 常驻后台 + 屏幕常亮 + 关于） -->
    <LinearLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#EE111111"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置（家长）"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPinSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置 / 修改 父母门禁 PIN" />

        <Button
            android:id="@+id/btnPinClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清除 父母门禁 PIN"
            android:layout_marginTop="8dp" />

        <Switch
            android:id="@+id/swKeepScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="屏幕常亮"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

        <Switch
            android:id="@+id/swBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="常驻后台（电池优化豁免）"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="退出应用"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnSettingsClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关闭"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</FrameLayout>
