# gradlew 必须是 LF 换行，否则在 Linux(GitHub Actions) 上会因 CRLF 报 bad interpreter
gradlew        text eol=lf
gradlew.bat    text eol=crlf

# 其余源码统一 LF
*.kt           text eol=lf
*.java         text eol=lf
*.gradle       text eol=lf
*.properties   text eol=lf
*.xml          text eol=lf
*.yml          text eol=lf
*.md           text eol=lf
